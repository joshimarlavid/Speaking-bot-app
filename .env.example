# Required for Gemini Live conversation and AI feedback; create a key in Google AI Studio.
GEMINI_API_KEY=

# Optional for ElevenLabs voices; create a key in the ElevenLabs dashboard.
ELEVEN_API_KEY=

# Optional Node runtime environment (set by your deployment platform).
NODE_ENV=

# Optional Vite development setting; set to true to disable hot module replacement.
DISABLE_HMR=

# Set automatically by Vitest while running tests.
VITEST=